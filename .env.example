# The server's personal token, the same one configured in the app.
# To generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FONOTE_TOKEN=

# Football data comes from ESPN's public feed: no key to fill in.

# Image published on the private registry.
FONOTE_BACKEND_IMAGE=registry.mmyumu.fr/fonote-backend:1.5.0

# Shared ESPN request cadence (seconds). These are local limits, not a provider guarantee.
FONOTE_ESPN_INTERVAL=2
FONOTE_ESPN_BACKGROUND_INTERVAL=10
# After investigating an ESPN 403, set FONOTE_ESPN_RESUME=1 for one restart, then remove it.
