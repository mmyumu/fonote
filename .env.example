# Jeton personnel du serveur, le même que celui configuré dans l'application.
# En générer un : python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FONOTE_TOKEN=

# Clé football-data.org, facultative : sans elle l'application reste en démo hors ligne.
FOOTBALL_DATA_TOKEN=

# Image publiée sur le registre privé.
FONOTE_BACKEND_IMAGE=registry.mmyumu.fr/fonote-backend:1.0.0
