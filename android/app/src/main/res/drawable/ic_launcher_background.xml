<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- The night lawn of the original theme, as a bottom-to-top gradient so that the
         launcher's mask — round, square or teardrop — never lands on a flat fill. -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="108" android:endX="108" android:endY="0"
                android:startColor="#FF0A1E19" android:endColor="#FF1A3E32" />
        </aapt:attr>
    </path>
</vector>
