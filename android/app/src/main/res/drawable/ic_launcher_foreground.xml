<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- The notebook lying on the lawn: a page of kraft paper, its lemon spiral, and the
         pitch drawn on it. The app's name says both halves — football and the note — and
         that is what the drawing shows, rather than one of the two.

         The icon's lawn is lighter than the tactical board's, which is a night green; here
         it has the launcher's dark background on one side and the paper on the other, and a
         night green would have merged into the former. The markings are white, as on a real
         pitch, and no longer in green ink: on that green they hold the 3:1 ratio a stroke
         must keep to stay legible, which is also why the paper is a light kraft and not a
         plain brown — any darker, it would bring the page closer to the background and leave
         the white to carry the icon on its own.

         The pitch stands upright, like the page, and takes up almost its full height: that
         is what leaves room for the penalty areas, and it is they, with the centre circle,
         that make it read as a pitch rather than a board. The corner arcs and the goal
         areas, for their part, would clog into a blot at forty-eight points and are left
         out.

         Everything fits in the 66dp disc the launcher guarantees, spiral included. -->
    <path android:fillColor="#FFE7D3AE"
        android:pathData="M37,34 L71,34 Q75,34 75,38 L75,77 Q75,81 71,81 L37,81 Q33,81 33,77 L33,38 Q33,34 37,34 Z" />
    <path android:strokeColor="#FFCFF0A0" android:strokeWidth="3.8" android:strokeLineCap="round"
        android:fillColor="#00000000" android:pathData="M44,27 L44,38.5 M54,27 L54,38.5 M64,27 L64,38.5" />

    <!-- The lawn, and the mowing stripes: two passes out of four darkened a touch, which is
         enough to give grass rather than a flat fill without adding anything to read. -->
    <path android:fillColor="#FF3F9160" android:pathData="M38,42 L70,42 L70,76 L38,76 Z" />
    <group>
        <clip-path android:pathData="M38,42 L70,42 L70,76 L38,76 Z" />
        <path android:fillColor="#14000000"
            android:pathData="M38,42 L70,42 L70,50.5 L38,50.5 Z M38,59 L70,59 L70,67.5 L38,67.5 Z" />
    </group>

    <!-- The touchlines and the halfway line. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.9" android:strokeLineJoin="round"
        android:fillColor="#00000000" android:pathData="M39,43 L69,43 L69,75 L39,75 Z" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8"
        android:fillColor="#00000000" android:pathData="M39,59 L69,59" />
    <!-- The centre circle and its spot. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8"
        android:fillColor="#00000000" android:pathData="M54,53.4 A5.6,5.6 0 1,1 53.9,53.4 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,59 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0 z" />
    <!-- The two penalty areas, and the penalty spots. -->
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" android:strokeLineJoin="round"
        android:fillColor="#00000000" android:pathData="M45,43 L45,49 L63,49 L63,43" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="1.8" android:strokeLineJoin="round"
        android:fillColor="#00000000" android:pathData="M45,75 L45,69 L63,69 L63,75" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,46.6 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 z
                          M54,71.4 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 z" />
</vector>
